# ============================================================
#  The Conscious Orbit — FastAPI backend configuration
#  This file is gitignored. Copy .env.example and fill it in.
# ============================================================

# --- Database -------------------------------------------------
# Without this the app falls back to the SQLite file
# conscious_orbit_local_v2.db, which is fine for local work.
DATABASE_URL=postgresql://postgres:yourpassword@127.0.0.1:5432/conscious_orbit

# --- Frontend origin allowed to call this API -----------------
CORS_ORIGIN=http://localhost:5173

# --- Sessions -------------------------------------------------
# Tokens are signed with this. Leave it unset and a random key is
# generated per process, which logs everyone out on every restart.
AUTH_SECRET=generate-a-long-random-string
TOKEN_TTL_HOURS=12

# --- AI (Gemini) ----------------------------------------------
# Paste a key from https://aistudio.google.com/apikey below and
# restart the backend. Without it every AI feature still works but
# returns the deterministic heuristic instead of a reasoned review;
# the ten module scores are pure maths and are identical either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Email delivery of approved reports -----------------------
# Without SMTP_HOST the approved-report email is composed and logged
# but never sent. For Gmail use an App Password, not the account
# password (host smtp.gmail.com, port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM='The Conscious Orbit <reports@consciousorbit.com>'

# --- Competitor intelligence (optional) -----------------------
# Without these, module 6 returns clearly-labelled placeholder data.
SPYFU_API_ID=
SPYFU_SECRET_KEY=
