# Copy to .env.local for local dev. Vite only exposes VITE_-prefixed vars.
#
# Where the Express API in server/ is reachable. Leave unset to use the
# localhost default. When the API cannot be reached the dashboard falls back
# to its built-in simulation, so the static build works with no backend.
VITE_API_URL=http://localhost:4000/api
